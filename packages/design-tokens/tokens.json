{
  "$schema": "../tokens.schema.json",
  "pack": "admin",
  "version": "3.0.0",
  "prefix": "lp",
  "naming": "--lp-<category>-<role>[-<variant>][-<state>]",
  "rules": {
    "spaceBase": 4,
    "spaceAllowed": [
      0,
      2,
      4,
      8,
      12,
      16,
      24,
      32,
      40,
      48,
      64,
      96
    ],
    "proximityTiers": [
      4,
      8,
      16,
      24,
      40
    ],
    "typeRamp": [
      12,
      13,
      14,
      16,
      18,
      20,
      24,
      28,
      32,
      40,
      48
    ],
    "lineHeightStep": 4,
    "weightsAllowed": [
      400,
      500,
      600,
      700
    ],
    "letterSpacingUnit": "em",
    "layoutLattice": [
      320,
      400,
      480,
      640,
      720,
      800,
      960,
      1200
    ],
    "sizeStep": 4,
    "radiusAllowed": [
      0,
      4,
      8,
      12,
      999
    ],
    "borderAllowed": [
      0,
      1,
      2,
      4
    ],
    "elevationRatio": 2,
    "motionDurationsMs": [
      0,
      80,
      160,
      240,
      960
    ],
    "motionEasingsAllowed": [
      "standard",
      "out"
    ],
    "zIndexStep": 100,
    "minTextContrast": 4.5,
    "minUiContrast": 3
  },
  "oklchSeeds": {
    "curve": "OKLCH lightness ramp L=0.98..0.18 with chroma peak at mid-tones; semantic tokens retain exact hex overrides where OKLCH delta-E 2000 > 1.5 vs WP-16.L baseline",
    "neutral": "oklch(0.55 0.02 240)",
    "indigo": "oklch(0.50 0.19 266)",
    "blue": "oklch(0.52 0.12 252)",
    "green": "oklch(0.50 0.11 160)",
    "amber": "oklch(0.58 0.13 80)",
    "red": "oklch(0.48 0.18 26)"
  },
  "proximity": {
    "1": "{primitive.space.4}",
    "2": "{primitive.space.8}",
    "3": "{primitive.space.16}",
    "4": "{primitive.space.24}",
    "5": "{primitive.space.40}"
  },
