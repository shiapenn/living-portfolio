{
  "$schema": "../tokens.schema.json",
  "pack": "public",
  "version": "1.0.0",
  "prefix": "pub",
  "naming": "--pub-<category>-<role>[-<variant>]",
  "rules": {
    "spaceBase": 4,
    "spaceMax": 256,
    "spaceAllowed": [
      0,
      2,
      4,
      8,
      12,
      16,
      24,
      32,
      40,
      48,
      64,
      80,
      96,
      128,
      160,
      192,
      256
    ],
    "typeScale": {
      "kind": "fluid-modular",
      "ratio": 1.25,
      "minBasePx": 16,
      "maxBasePx": 18
    },
    "borderAllowed": [
      0,
      1,
      2,
      4
    ],
    "radiusAllowed": [
      0,
      2,
      4,
      8,
      12,
      16,
      999
    ],
    "motionDurationsMs": [
      0,
      120,
      200,
      320,
      480
    ],
    "minTextContrast": 4.5,
    "minUiContrast": 3
  },
  "oklchSeeds": {
    "paper": "oklch(0.985 0.004 240)",
    "ink": "oklch(0.22 0.025 240)",
    "accent": "oklch(0.50 0.19 266)"
  },
  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "paper-50": "#F5F6F7",
      "paper-100": "#EEF1F3",
      "paper-150": "#EBEFF2",
      "paper-200": "#E1E6EA",
      "paper-300": "#CBD3D8",
      "ink-400": "#6B7B88",
      "ink-500": "#63727E",
      "ink-600": "#4B5A66",
      "ink-700": "#2D3B45",
      "ink-900": "#14202A",
      "night-950": "#0F1A22",
      "night-900": "#16232D",
      "night-800": "#1E2E3B",
      "night-700": "#2A3946",
      "night-500": "#7E8F9C",
      "night-400": "#8A99A6",
      "night-300": "#A3B2BD",
      "night-100": "#E6ECEF",
      "accent-600": "#3A4FD0",
      "accent-800": "#1E329E",
      "accent-300": "#9AA8FF",
      "accent-200": "#C5CEFF",
      "accent-50": "#EEF1FF",
      "accent-900": "#1A244D",
      "strata-goal-light": "#2F5FA8",
      "strata-goal-dark": "#8DB4EA",
      "strata-friction-light": "#9A6A00",
      "strata-friction-dark": "#E2B34A",
      "strata-decision-light": "#5B3FA0",
      "strata-decision-dark": "#B9A4EE",
      "strata-outcome-light": "#1F7A5A",
      "strata-outcome-dark": "#6FCBA3",
      "strata-lesson-light": "#A13A6B",
      "strata-lesson-dark": "#EE9CC2"
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px",
      "40": "160px",
      "48": "192px",
      "64": "256px",
      "0-5": "2px"
    },
    "radius": {
      "0": "0px",
      "2": "2px",
      "4": "4px",
      "8": "8px",
      "12": "12px",
      "16": "16px",
      "full": "999px"
    },
    "border": {
      "0": "0px",
      "1": "1px",
      "2": "2px",
      "4": "4px"
    },
    "font": {
      "family-display": "'Literata', Georgia, 'Times New Roman', serif",
      "family-prose": "'Literata', Georgia, 'Times New Roman', serif",
      "family-ui": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "family-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "size-caption": "clamp(0.75rem, 0.72rem + 0.15vw, 0.875rem)",
      "size-body": "clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem)",
      "size-lead": "clamp(1.0625rem, 1rem + 0.35vw, 1.25rem)",
      "size-heading-sm": "clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem)",
      "size-heading-md": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)",
      "size-display": "clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem)",
      "line-tight": "1.2",
      "line-ui": "1.45",
      "line-prose": "1.65",
      "weight-400": "400",
      "weight-600": "600",
      "letter-tight": "-0.015em",
      "letter-normal": "0em",
      "letter-wide": "0.04em"
    },
    "motion": {
      "duration-0": "0ms",
      "duration-fast": "120ms",
      "duration-base": "200ms",
      "duration-slow": "320ms",
      "duration-editorial": "480ms",
      "easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
      "easing-out": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "elevation": {
      "none": "none",
      "card-light": "0 4px 16px rgba(20, 32, 42, 0.08)",
      "card-dark": "0 4px 16px rgba(0, 0, 0, 0.45)",
      "raised-light": "0 8px 32px rgba(20, 32, 42, 0.14)",
      "raised-dark": "0 8px 32px rgba(0, 0, 0, 0.60)"
    }
  },
  "semantic": {
    "light": {
      "color.surface.canvas": "{primitive.color.white}",
      "color.surface.paper": "{primitive.color.paper-50}",
      "color.surface.elevated": "{primitive.color.paper-150}",
      "color.text.primary": "{primitive.color.ink-900}",
      "color.text.secondary": "{primitive.color.ink-600}",
      "color.text.muted": "{primitive.color.ink-500}",
      "color.text.on-accent": "{primitive.color.white}",
      "color.border.rule": "{primitive.color.paper-300}",
      "color.border.strong": "{primitive.color.ink-400}",
      "color.accent.primary": "{primitive.color.accent-600}",
      "color.accent.tint": "{primitive.color.accent-50}",
      "color.accent.ink": "{primitive.color.accent-800}",
      "color.strata.goal": "{primitive.color.strata-goal-light}",
      "color.strata.friction": "{primitive.color.strata-friction-light}",
      "color.strata.decision": "{primitive.color.strata-decision-light}",
      "color.strata.outcome": "{primitive.color.strata-outcome-light}",
      "color.strata.lesson": "{primitive.color.strata-lesson-light}",
      "elevation.card": "{primitive.elevation.card-light}",
      "elevation.raised": "{primitive.elevation.raised-light}"
    },
    "dark": {
      "color.surface.canvas": "{primitive.color.night-950}",
      "color.surface.paper": "{primitive.color.night-900}",
      "color.surface.elevated": "{primitive.color.night-800}",
      "color.text.primary": "{primitive.color.night-100}",
      "color.text.secondary": "{primitive.color.night-300}",
      "color.text.muted": "{primitive.color.night-400}",
      "color.text.on-accent": "{primitive.color.night-950}",
      "color.border.rule": "{primitive.color.night-700}",
      "color.border.strong": "{primitive.color.night-500}",
      "color.accent.primary": "{primitive.color.accent-300}",
      "color.accent.tint": "{primitive.color.accent-900}",
      "color.accent.ink": "{primitive.color.accent-200}",
      "color.strata.goal": "{primitive.color.strata-goal-dark}",
      "color.strata.friction": "{primitive.color.strata-friction-dark}",
      "color.strata.decision": "{primitive.color.strata-decision-dark}",
      "color.strata.outcome": "{primitive.color.strata-outcome-dark}",
      "color.strata.lesson": "{primitive.color.strata-lesson-dark}",
      "elevation.card": "{primitive.elevation.card-dark}",
      "elevation.raised": "{primitive.elevation.raised-dark}"
    }
  },
  "component": {
    "space.page-gutter": "{primitive.space.4}",
    "space.section": "{primitive.space.12}",
    "space.atmosphere": "{primitive.space.16}",
    "space.card-pad": "{primitive.space.6}",
    "space.stack-sm": "{primitive.space.2}",
    "space.stack-md": "{primitive.space.4}",
    "space.stack-lg": "{primitive.space.8}",
    "size.layout-max": "1200px",
    "size.reading-measure": "68ch",
    "radius.card": "{primitive.radius.8}",
    "radius.pill": "{primitive.radius.full}",
    "border.hairline": "{primitive.border.1}",
    "border.accent": "{primitive.border.4}",
    "font.family-display": "{primitive.font.family-display}",
    "font.family-prose": "{primitive.font.family-prose}",
    "font.family-ui": "{primitive.font.family-ui}",
    "font.family-mono": "{primitive.font.family-mono}",
    "font.size-caption": "{primitive.font.size-caption}",
    "font.size-body": "{primitive.font.size-body}",
    "font.size-lead": "{primitive.font.size-lead}",
    "font.size-heading-sm": "{primitive.font.size-heading-sm}",
    "font.size-heading-md": "{primitive.font.size-heading-md}",
    "font.size-display": "{primitive.font.size-display}",
    "font.line-tight": "{primitive.font.line-tight}",
    "font.line-ui": "{primitive.font.line-ui}",
    "font.line-prose": "{primitive.font.line-prose}",
    "motion.duration-fast": "{primitive.motion.duration-fast}",
    "motion.duration-base": "{primitive.motion.duration-base}",
    "motion.duration-slow": "{primitive.motion.duration-slow}",
    "motion.easing-standard": "{primitive.motion.easing-standard}",
    "motion.easing-out": "{primitive.motion.easing-out}"
  },
  "governance": {
    "default": {
      "status": "active",
      "since": "WP-16.M",
      "replacedBy": null
    },
    "aliases": {
      "space.stack-md": {
        "aliasOf": "space.page-gutter",
        "reason": "Medium vertical stack rhythm distinct from horizontal page gutter"
      },
      "font.family-prose": {
        "aliasOf": "font.family-display",
        "reason": "Reading body uses editorial serif stack matching display headings"
      }
    }
  },
  "accentMapping": {
    "light": {
      "color.accent.primary": 600,
      "color.accent.tint": 50,
      "color.accent.ink": 800
    },
    "dark": {
      "color.accent.primary": 300,
      "color.accent.tint": 900,
      "color.accent.ink": 200
    }
  }
}
