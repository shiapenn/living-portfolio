#!/usr/bin/env node
/**
 * Unified Local Verification Suite (`scripts/verify-all`, Instruction 7)
 * Runs all required repository gates in sequence.
 */
import { execSync } from 'node:child_process';
import { resolve } from 'node:path';

const ROOT = resolve(import.meta.dirname, '..');

const steps = [
  { name: 'Build & Typecheck', command: 'pnpm build' },
  { name: 'Environment Sync & Drift Check (OSR-03)', command: 'node scripts/generate-env-example && git diff --exit-code .env.example' },
  { name: 'OpenAPI Specification & Contract Drift Check (OSR-12)', command: 'node scripts/verify-openapi-drift' },
  { name: 'Frontend & Backend Decoupling Dependency Rules (OSR-13)', command: 'node scripts/verify-dependency-rules' },
  { name: 'Hard-Code Inventory Scan (OSR-01)', command: 'node scripts/hardcode-check' },
  { name: 'Developer Certificate of Origin (OSR-07 dco)', command: 'node scripts/dco-check' },
  { name: 'Documentation Identity & Registry Check (IAHP PROC-1)', command: 'node scripts/docs-check' },
  { name: 'Handover Protocol Conformance (IAHP HO-1)', command: 'node scripts/handover-check' },
  { name: 'Audit Governance & Conformance Check (DR-AUD-001 AUD-21)', command: 'node scripts/audit-check' },
  { name: 'CSS Custom Property Definition Check (WP-14.6, UI-01, UI-03)', command: 'node scripts/verify-css-variables' },
  { name: 'UI Contract & Size-Budget Guard Check (WP-15.6, D-CONTRACT-5)', command: 'node scripts/verify-ui-guards' },
  { name: 'SARIF Static Analysis Baseline Gate (baseline validated; no analysis run)', command: 'node scripts/sarif-gate' },
  { name: 'Gitleaks Secret Scan (Instruction 5)', command: 'node scripts/gitleaks-scan' },
  { name: 'GitHub Action SHA Pins Verification (CI fix 3a)', command: 'node scripts/verify-action-pins' },
  { name: 'Unit, Conformance & P0 Regression Suites (AUD-14, AUD-15, D.1, D.2)', command: 'pnpm test' },
];

console.log('=== Living Portfolio Unified Verification Suite (pnpm verify) ===\n');

for (let i = 0; i < steps.length; i++) {
  const step = steps[i];
  console.log(`[${i + 1}/${steps.length}] Running ${step.name}...`);
  try {
    execSync(step.command, { cwd: ROOT, stdio: 'inherit' });
    console.log(`✓ [${i + 1}/${steps.length}] ${step.name} PASSED.\n`);
  } catch (err) {
    console.error(`\n✗ [${i + 1}/${steps.length}] ${step.name} FAILED.`);
    process.exit(1);
  }
}

console.log('====================================================');
console.log('🎉 All repository gates passed successfully.');
console.log('====================================================');
