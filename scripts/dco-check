#!/usr/bin/env node
/**
 * Developer Certificate of Origin (DCO) Sign-Off Verifier (`scripts/dco-check`, OSR-07 §5.1)
 * Verifies that commit messages (or a commit-msg file passed as $1) contain a valid
 * `Signed-off-by: Full Name <email@domain>` trailer.
 *
 * CI mode (20261020 CI fix 3c): verifies EVERY non-merge commit in the range, not only HEAD.
 * Range resolution order:
 *   1. `DCO_COMMIT_RANGE` (e.g. `origin/main..HEAD`), if set
 *   2. `DCO_BASE_SHA..DCO_HEAD_SHA` (set by CI from the pull_request / push event)
 *      - If base is unreachable or all zeros (force push, rewritten history, new branch),
 *        falls back to checking full history and prints an explicit notice.
 *   3. `HEAD~1..HEAD` (local fallback; a single commit)
 */
import { readFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';

const DCO_REGEX = /^Signed-off-by:\s+.+\s+<[^@\s]+@[^@\s]+>/m;
const ZERO_SHA = /^0{40}$/;

export function verifyDcoMessage(message) {
  return DCO_REGEX.test(message);
}

function git(args) {
  return execFileSync('git', args, { encoding: 'utf8' }).trim();
}

export function isCommitReachable(sha) {
  if (!sha || ZERO_SHA.test(sha)) return false;
  try {
    execFileSync('git', ['cat-file', '-e', `${sha}^{commit}`], { stdio: 'pipe' });
    return true;
  } catch {
    return false;
  }
}

export function resolveCommitList(env = process.env) {
  const head = env.DCO_HEAD_SHA || 'HEAD';
  if (env.DCO_COMMIT_RANGE) {
    const range = env.DCO_COMMIT_RANGE;
    const shas = git(['rev-list', '--no-merges', range]).split('\n').filter(Boolean);
    return { shas, rangeDescription: range };
  }

  const base = env.DCO_BASE_SHA;
  if (base) {
    if (ZERO_SHA.test(base) || !isCommitReachable(base)) {
      console.log(
        `[OSR-07 DCO] Notice: Base commit (${base}) is unreachable or all zeros (force push / rewritten history / new branch). Falling back to checking full repository history.`
      );
      const shas = git(['rev-list', '--no-merges', head]).split('\n').filter(Boolean);
      return { shas, rangeDescription: `full history up to ${head}` };
    }
    const range = `${base}..${head}`;
    const shas = git(['rev-list', '--no-merges', range]).split('\n').filter(Boolean);
    return { shas, rangeDescription: range };
  }

  // Local fallback: tip commit
  try {
    const range = `${head}~1..${head}`;
    let shas = git(['rev-list', '--no-merges', range]).split('\n').filter(Boolean);
    if (shas.length === 0) {
      shas = [git(['rev-parse', head])];
    }
    return { shas, rangeDescription: range };
  } catch {
    return { shas: [git(['rev-parse', head])], rangeDescription: head };
  }
}

const arg = process.argv[2];

if (arg && !arg.startsWith('--')) {
  // Invoked as a git `commit-msg` hook with path to `.git/COMMIT_EDITMSG`
  const msg = readFileSync(arg, 'utf8');
  if (!verifyDcoMessage(msg)) {
    console.error('✗ [OSR-07 DCO] Commit rejected: missing valid "Signed-off-by: Name <email>" trailer.');
    console.error('  Use `git commit -s` to sign off your commit under the Developer Certificate of Origin (DCO).');
    process.exit(1);
  }
  console.log('✓ [OSR-07 DCO] Commit message sign-off verified.');
  process.exit(0);
}

try {
  const { shas, rangeDescription } = resolveCommitList();
  if (shas.length === 0) {
    console.log(`✓ [OSR-07 DCO] No non-merge commits found in ${rangeDescription}.`);
    process.exit(0);
  }
  const missing = shas.filter((sha) => !verifyDcoMessage(git(['log', '-1', '--format=%B', sha])));
  if (missing.length) {
    console.error(`✗ [OSR-07 DCO] ${missing.length} of ${shas.length} commit(s) in ${rangeDescription} lack a valid "Signed-off-by: Name <email>" trailer:`);
    for (const sha of missing) console.error(`  - ${git(['log', '-1', '--format=%h %s', sha])}`);
    console.error('  Fix with `git rebase --signoff <base>` (or `git commit --amend -s` for a single commit).');
    process.exit(1);
  }
  console.log(`✓ [OSR-07 DCO] All ${shas.length} commit(s) in ${rangeDescription} carry a valid Signed-off-by trailer.`);
} catch (err) {
  console.error(`✗ [OSR-07 DCO] Failed to inspect git commit range:`, err.message);
  process.exit(1);
}
