#!/usr/bin/env node
/**
 * Hardened Gitleaks Scanner (`scripts/gitleaks-scan`, Instruction 5)
 *
 * Scans the full repository history on every push, schedule, and local run,
 * and scans across the PR commit range on pull requests.
 * Outputs the binary version and number of commits scanned.
 */
import { execFileSync, spawnSync } from 'node:child_process';
import { resolve } from 'node:path';

const ROOT = resolve(import.meta.dirname, '..');
const GITLEAKS_VERSION = process.env.GITLEAKS_VERSION || '8.30.1';

console.log('=== Gitleaks Secret Scanner (Instruction 5) ===\n');

// 1. Verify Gitleaks binary & print version
let versionOutput = '';
try {
  versionOutput = execFileSync('gitleaks', ['version'], { encoding: 'utf8' }).trim();
  console.log(`Gitleaks binary version: ${versionOutput} (configured GITLEAKS_VERSION: ${GITLEAKS_VERSION})\n`);
} catch (err) {
  console.error(`✗ Gitleaks binary not found or failed to execute: ${err.message}`);
  console.error('  Install gitleaks (e.g. brew install gitleaks or via CI install step).');
  process.exit(1);
}

// 2. Determine scan arguments
const isPullRequest =
  process.env.GITHUB_EVENT_NAME === 'pull_request' ||
  (process.env.DCO_BASE_SHA && process.env.GITHUB_BASE_REF);

let scanArgs = ['git', '--verbose', '.'];

if (isPullRequest && process.env.DCO_BASE_SHA && process.env.DCO_HEAD_SHA) {
  const base = process.env.DCO_BASE_SHA;
  const head = process.env.DCO_HEAD_SHA;
  console.log(`Pull request event detected: scanning commit range ${base}..${head}`);
  scanArgs = ['git', `--log-opts=--no-merges ${base}..${head}`, '--verbose', '.'];
} else {
  console.log('Push/Schedule/Local event: scanning FULL git history across all commits');
}

// 3. Execute gitleaks
const res = spawnSync('gitleaks', scanArgs, {
  cwd: ROOT,
  stdio: 'inherit',
  env: { ...process.env, GITLEAKS_VERSION },
});

if (res.status !== 0) {
  console.error('\n✗ Gitleaks scan detected leaks or failed.');
  process.exit(res.status || 1);
}

console.log('\n✓ Gitleaks scan passed with 0 leaks.');
