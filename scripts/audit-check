#!/usr/bin/env node
/**
 * Audit Governance & Conformance Gate (`scripts/audit-check`)
 * Implements DR-AUD-001 requirements AUD-01 through AUD-21.
 */
import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { execSync } from 'node:child_process';
import { parse as parseYaml } from '../packages/core/node_modules/yaml/browser/index.js';

const ROOT = resolve(import.meta.dirname, '..');
const isReleaseTag =
  process.argv.includes('--release') ||
  process.env.GITHUB_REF_TYPE === 'tag' ||
  (process.env.GITHUB_REF && process.env.GITHUB_REF.startsWith('refs/tags/'));

const errors = [];
function fail(msg) {
  errors.push(msg);
  console.error(`  ✗ ${msg}`);
}
function pass(msg) {
  console.log(`  ✓ ${msg}`);
}

console.log('=== Living Portfolio Audit Governance Check (DR-AUD-001) ===\n');

// 1. Verify required layout (AUD-01, AUD-02, AUD-05, AUD-06, A.1, OSR-06..OSR-11)
const requiredPaths = [
  'docs/spec/The_Living_Portfolio_Open_Source_Spec.md',
  'docs/spec/openapi.json',
  'docs/governance/DR-AUD-001.md',
  'docs/governance/flip-day-checklist.md',
  'docs/governance/CHANGELOG.md',
  'docs/governance/rulesets/main-branch-ruleset.json',
  'docs/governance/rulesets/release-tag-ruleset.json',
  'docs/plans/remediation-plan-AUD-2026-10-19.md',
  'docs/plans/osr-001-open-source-release.md',
  'docs/execution-reports/A001.md',
  'docs/execution-reports/A002.md',
  'docs/execution-reports/A003.md',
  'docs/execution-reports/A004.md',
  'docs/execution-reports/A005.md',
  'docs/execution-reports/A006.md',
  'docs/execution-reports/A007.md',
  'docs/execution-reports/OSR-05-clean-tree-and-rotation.md',
  'docs/audits/README.md',
  'docs/audits/register.yml',
  'docs/audits/conformance.yml',
  'docs/audits/hardcode-inventory.md',
  'docs/audits/sarif-baseline.json',
  'scripts/historical-sha-map.json',
  'scripts/gitleaks-checksums.json',
  'scripts/sarif-gate',
  'scripts/gitleaks-scan',
  'scripts/verify-all',
  'scripts/generate-openapi',
  'scripts/verify-openapi-drift',
  'apps/api/src/conformance/sarif-gate.conformance.test.ts',
  'apps/api/src/conformance/openapi.conformance.test.ts',
  'docs/audits/2026-10-19-independent-technical-audit/report.md',
  'docs/audits/2026-10-19-independent-technical-audit/findings.snapshot.yml',
  'docs/audits/2026-10-19-independent-technical-audit/repro/p0-probes.ts',
  'docs/doc-registry.json',
  'docs/INDEX.md',
  'docs/plans/P001-iterative-agent-handover-protocol.md',
  'docs/templates/G001-handover-template.md',
  'scripts/docs-new',
  'scripts/docs-check',
  'scripts/docs-index',
  'scripts/handover-check',
  'scripts/handover-verify',
  'scripts/handover-facts',
  'scripts/changed-scope',
  'scripts/triage',
  'docs/plans/gates.json',
  'LICENSE',
  'THIRD_PARTY_NOTICES',
  'DCO',
  'SECURITY.md',
  'CODEOWNERS',
  'TRADEMARKS.md',
  'KNOWN_ISSUES.md',
  'CONTRIBUTING.md',
  '.github/pull_request_template.md',
  '.github/release-template.md',
];

for (const rel of requiredPaths) {
  if (!existsSync(resolve(ROOT, rel))) {
    fail(`[AUD-02/OSR-06] Missing required path: ${rel}`);
  }
}
if (errors.length === 0) {
  pass('[AUD-01..AUD-06, A.1, OSR-06..11] Required docs/, governance, plans, and open-source release files verified.');
}

// 2. Verify closed audit folder immutability (AUD-03, AUD-21)
const CLOSED_AUDIT_HASHES = {
  'docs/audits/2026-10-19-independent-technical-audit/report.md':
    '65ebe5b57ccd25c836a80862c4ead510e9e2a00b0bbd947f6a4cc4d3d151ed49',
  'docs/audits/2026-10-19-independent-technical-audit/findings.snapshot.yml':
    'cc0c198af28bd0bc59602eb8e7a078d338b08be712165d9f484f45922901d47a',
  'docs/audits/2026-10-19-independent-technical-audit/repro/p0-probes.ts':
    'aa9d5b1ddfad2409234846a2650bf291ef7f83a5bffd47f0e3393929ea5af444',
};

let immutabilityOk = true;
for (const [rel, expectedHash] of Object.entries(CLOSED_AUDIT_HASHES)) {
  const full = resolve(ROOT, rel);
  if (!existsSync(full)) continue;
  const actualHash = createHash('sha256').update(readFileSync(full)).digest('hex');
  if (actualHash !== expectedHash) {
    immutabilityOk = false;
    fail(`[AUD-03/AUD-21] Closed audit file modified: ${rel} (expected ${expectedHash}, got ${actualHash})`);
  }
}
if (immutabilityOk) {
  pass('[AUD-03/AUD-21] Closed audit folder (2026-10-19-independent-technical-audit) checksums intact.');
}

// 3. Parse and validate register.yml (AUD-07..AUD-10, AUD-14, AUD-16, AUD-21)
const registerRaw = readFileSync(resolve(ROOT, 'docs/audits/register.yml'), 'utf8');
const register = parseYaml(registerRaw);
if (!Array.isArray(register)) {
  fail('[AUD-08] register.yml must parse to a top-level YAML list.');
} else {
  const seenIds = new Set();
  const coveredFixIds = new Set();
  const validSeverities = new Set(['P0', 'P1', 'P2', 'P3']);
  const validStatuses = new Set(['open', 'in-progress', 'partial', 'fixed', 'accepted-risk', 'wont-fix']);
  const findingMap = new Map();

  for (const item of register) {
    if (!item.id || seenIds.has(item.id)) {
      fail(`[AUD-07] Duplicate or missing finding ID: ${item.id}`);
    }
    seenIds.add(item.id);
    findingMap.set(item.id, item);

    if (!validSeverities.has(item.severity)) {
      fail(`[AUD-08] Invalid severity '${item.severity}' on finding ${item.id}`);
    }
    if (!validStatuses.has(item.status)) {
      fail(`[AUD-08] Invalid status '${item.status}' on finding ${item.id}`);
    }
    if (!item.owner) {
      fail(`[AUD-08] Missing owner on finding ${item.id}`);
    }
    if (!Array.isArray(item.history) || item.history.length === 0) {
      fail(`[AUD-09] Missing history on finding ${item.id}`);
    }
    if (Array.isArray(item.fix_ids)) {
      for (const fId of item.fix_ids) coveredFixIds.add(fId);
    }

    // AUD-10: accepted-risk and wont-fix require rationale and approved_by
    if (item.status === 'accepted-risk' || item.status === 'wont-fix') {
      if (!item.rationale || !item.approved_by) {
        fail(`[AUD-10] Finding ${item.id} is '${item.status}' but lacks rationale or approved_by.`);
      }
    }

    // D.4: verified_by field must exist on every register entry
    if (!('verified_by' in item)) {
      fail(`[D.4] Finding ${item.id} is missing required 'verified_by' field in register.yml.`);
    }

    // AUD-14 & AUD-21: fixed findings must have an existing regression_test file
    if (item.status === 'fixed') {
      if (!item.regression_test || !existsSync(resolve(ROOT, item.regression_test))) {
        fail(`[AUD-14/AUD-21] Fixed finding ${item.id} lacks an existing regression_test file (${item.regression_test}).`);
      }
    }

    // AUD-16 & AUD-21: no P0 can be open on a tagged release
    if (isReleaseTag && item.severity === 'P0' && (item.status === 'open' || item.status === 'in-progress' || item.status === 'partial')) {
      fail(`[AUD-16/AUD-21] Release gate blocked: P0 finding ${item.id} is '${item.status}'.`);
    }
  }

  // Verify all 29 §5 IDs exist
  const requiredReportIds = [
    'S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7',
    'G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8',
    'B1', 'B2', 'B3', 'B4',
    'P1', 'P2', 'P3', 'P4', 'P5', 'P6',
    'F1', 'F2', 'F3', 'F4',
  ];
  for (const reqId of requiredReportIds) {
    if (!seenIds.has(reqId)) {
      fail(`[AUD-07] Missing required AUD-2026-10-19 finding ID in register.yml: ${reqId}`);
    }
  }

  // Verify all 26 prioritized fixes are mapped
  for (let fixNum = 1; fixNum <= 26; fixNum++) {
    if (!coveredFixIds.has(fixNum)) {
      fail(`[Criterion-2] Prioritized fix #${fixNum} is not mapped to any finding in register.yml.`);
    }
  }

  pass(`[AUD-07..AUD-16, D.4] register.yml parsed (${register.length} entries, all 26 fixes mapped, verified_by present, fixed-finding tests verified).`);

  // 4. Parse and validate conformance.yml (AUD-11..AUD-13, AUD-21)
  const conformanceRaw = readFileSync(resolve(ROOT, 'docs/audits/conformance.yml'), 'utf8');
  const conformance = parseYaml(conformanceRaw);
  const validConformanceStatuses = new Set([
    'implemented',
    'partial',
    'stub',
    'missing',
    'misleading',
    'non-conformant',
    'deviates',
  ]);

  if (!Array.isArray(conformance) || conformance.length === 0) {
    fail('[AUD-11] conformance.yml must parse to a non-empty list of spec sections.');
  } else {
    for (const row of conformance) {
      if (!validConformanceStatuses.has(row.status)) {
        fail(`[AUD-11] Invalid conformance status '${row.status}' on section ${row.section}`);
      }
      if (!row.last_scored) {
        fail(`[AUD-11] Missing last_scored on section ${row.section}`);
      }
      if (!Array.isArray(row.findings)) {
        fail('[AUD-11] Missing findings array on section ' + row.section);
      } else {
        for (const fId of row.findings) {
          if (!findingMap.has(fId)) {
            fail(`[AUD-11] Section ${row.section} references unknown finding ID '${fId}'`);
          }
        }
        // AUD-13: A section MAY be scored implemented only when its finding IDs are all fixed
        if (row.status === 'implemented') {
          for (const fId of row.findings) {
            const f = findingMap.get(fId);
            if (f && f.status !== 'fixed') {
              fail(`[AUD-13] Section ${row.section} is marked 'implemented' but finding ${fId} has status '${f.status}'.`);
            }
          }
        }
      }
    }
    pass(`[AUD-11..AUD-13] conformance.yml parsed (${conformance.length} spec section rows validated).`);
  }

  // 4b. Verify every 20261106-* finding maps to exactly one WP or lists explicit partial mappings with a reason in P004, gates.json, and register.yml
  const p004Raw = readFileSync(resolve(ROOT, 'docs/plans/P004-ux-remediation-work-packages.md'), 'utf8');
  const gatesRaw = JSON.parse(readFileSync(resolve(ROOT, 'docs/plans/gates.json'), 'utf8'));

  function parseFindingTokens(specText) {
    const entries = [];
    for (const rawPart of specText.split(',')) {
      const part = rawPart.trim();
      if (!part) continue;
      const isPart = /\bpart\b/i.test(part);
      const match = part.match(/(?:20261106-)?((?:UX|UI|CP)-\d{2,3})/);
      if (match) {
        entries.push({ shortId: match[1], fullId: `20261106-${match[1]}`, isPart });
      }
    }
    return entries;
  }

  const p004ByWp = new Map();
  const phaseMapMatch = p004Raw.match(/### 7\.2 Phase map([\s\S]*?)```/);
  if (!phaseMapMatch) {
    fail('[AUD-WP-MAP] Could not locate §7.2 Phase map table in docs/plans/P004-ux-remediation-work-packages.md.');
  } else {
    for (const line of phaseMapMatch[1].split('\n')) {
      const rowMatch = line.match(/^\|\s*(1[3-9]|20)\s*\|[^|]+\|[^|]+\|[^|]+\|\s*([^|]+?)\s*\|/);
      if (rowMatch) {
        const wpId = `WP-${rowMatch[1]}`;
        p004ByWp.set(wpId, parseFindingTokens(rowMatch[2]));
      }
    }
  }

  const gatesByWp = new Map();
  for (const wpNum of ['13', '14', '15', '16', '17', '18', '19', '20']) {
    const wpId = `WP-${wpNum}`;
    const desc = gatesRaw.gates?.[wpId]?.description || '';
    const trailingParen = desc.match(/\(([^()]+)\)\.\s*$/);
    if (!trailingParen) {
      fail(`[AUD-WP-MAP] ${wpId} description in docs/plans/gates.json lacks trailing finding list '(...)'.`);
    } else {
      gatesByWp.set(wpId, parseFindingTokens(trailingParen[1]));
    }
  }

  // Compare P004 §7.2 and gates.json per WP
  const p004FindingMap = new Map();
  const gatesFindingMap = new Map();
  for (const wpNum of ['13', '14', '15', '16', '17', '18', '19', '20']) {
    const wpId = `WP-${wpNum}`;
    const pList = p004ByWp.get(wpId) || [];
    const gList = gatesByWp.get(wpId) || [];
    const pSig = pList.map((e) => `${e.shortId}${e.isPart ? '(part)' : ''}`).sort().join(', ');
    const gSig = gList.map((e) => `${e.shortId}${e.isPart ? '(part)' : ''}`).sort().join(', ');
    if (pSig !== gSig) {
      fail(`[AUD-WP-MAP] ${wpId} finding mapping mismatch between P004 §7.2 ([${pSig}]) and gates.json ([${gSig}]).`);
    }
    for (const e of pList) {
      if (!p004FindingMap.has(e.fullId)) p004FindingMap.set(e.fullId, []);
      p004FindingMap.get(e.fullId).push({ wpId, isPart: e.isPart });
    }
    for (const e of gList) {
      if (!gatesFindingMap.has(e.fullId)) gatesFindingMap.set(e.fullId, []);
      gatesFindingMap.get(e.fullId).push({ wpId, isPart: e.isPart });
    }
  }

  const findings20261106 = register.filter((item) => item.id && item.id.startsWith('20261106-'));
  let wpMapErrors = 0;
  for (const item of findings20261106) {
    const mappings = p004FindingMap.get(item.id) || [];
    if (mappings.length === 0) {
      wpMapErrors++;
      fail(`[AUD-WP-MAP] Finding ${item.id} in register.yml is not mapped to any WP in P004 §7.2 / gates.json.`);
      continue;
    }
    const allHistoryNotes = (item.history || []).map((h) => h.note || '').join(' ');
    if (mappings.length === 1) {
      const m = mappings[0];
      if (m.isPart && item.status !== 'partial') {
        wpMapErrors++;
        fail(`[AUD-WP-MAP] Finding ${item.id} is marked (part) in single WP ${m.wpId}, but its register.yml status is '${item.status}' instead of 'partial'.`);
      }
    } else {
      const unparted = mappings.filter((m) => !m.isPart).map((m) => m.wpId);
      if (unparted.length > 0) {
        wpMapErrors++;
        fail(`[AUD-WP-MAP] Finding ${item.id} maps to multiple WPs (${mappings.map((m) => m.wpId).join(', ')}) without explicit '(part)' marker on: ${unparted.join(', ')}.`);
      }
      const missingWpRefs = mappings.filter((m) => !allHistoryNotes.includes(m.wpId)).map((m) => m.wpId);
      const hasReason = /partial|split|completes|addressed/i.test(allHistoryNotes) && allHistoryNotes.length >= 40;
      if (missingWpRefs.length > 0 || !hasReason) {
        wpMapErrors++;
        fail(`[AUD-WP-MAP] Finding ${item.id} has partial mappings across ${mappings.map((m) => m.wpId).join(', ')}, but register.yml history notes do not state a partial reason citing all mapped WPs (missing: ${missingWpRefs.join(', ') || 'reason'}).`);
      }
    }
  }
  for (const mappedId of p004FindingMap.keys()) {
    if (!findingMap.has(mappedId)) {
      wpMapErrors++;
      fail(`[AUD-WP-MAP] P004 / gates.json references unknown finding '${mappedId}' not in register.yml.`);
    }
  }
  if (wpMapErrors === 0) {
    pass(`[AUD-WP-MAP] Verified all ${findings20261106.length} 20261106-* findings map to a single WP or list explicit partial mappings with reasons across register.yml, P004, and gates.json.`);
  }
}

// 5. Verify SIMULATED(...) markers in API routes return 501 (AUD-17..AUD-19)
function walkTsFiles(dir) {
  const results = [];
  for (const entry of readdirSync(dir)) {
    const full = resolve(dir, entry);
    if (statSync(full).isDirectory()) {
      if (entry !== 'node_modules' && entry !== 'dist' && entry !== 'conformance') {
        results.push(...walkTsFiles(full));
      }
    } else if (entry.endsWith('.ts') && !entry.endsWith('.test.ts')) {
      results.push(full);
    }
  }
  return results;
}

const apiSourceFiles = walkTsFiles(resolve(ROOT, 'apps/api/src'));
let simulatedMarkersCount = 0;
for (const file of apiSourceFiles) {
  const content = readFileSync(file, 'utf8');
  const lines = content.split('\n');
  lines.forEach((line, idx) => {
    const match = line.match(/SIMULATED\(([A-Za-z0-9_-]+)\)/);
    if (match) {
      simulatedMarkersCount++;
      // Verify 501 status is returned within the surrounding 15 lines of the handler
      const windowText = lines.slice(idx, idx + 15).join('\n');
      if (!windowText.includes('501')) {
        fail(
          `[AUD-19] SIMULATED(${match[1]}) marker in ${relative(ROOT, file)}:${idx + 1} does not return HTTP 501 within handler.`
        );
      }
    }
  });
}
if (simulatedMarkersCount === 0) {
  fail('[AUD-17] Expected SIMULATED(...) markers in apps/api/src but found none.');
} else {
  pass(`[AUD-17..AUD-19] Verified ${simulatedMarkersCount} SIMULATED(...) route markers in apps/api/src all return 501.`);
}

// Helper: Historical SHA mapping and commit ancestor verification (DR-AUD-001 / Rewrite Errata)
const shaMapFile = resolve(import.meta.dirname, 'historical-sha-map.json');
const HISTORICAL_SHA_MAP = existsSync(shaMapFile)
  ? JSON.parse(readFileSync(shaMapFile, 'utf8'))
  : {};

function resolveSha(sha) {
  return HISTORICAL_SHA_MAP[sha] || sha;
}

function isAncestor(sha) {
  const target = resolveSha(sha);
  try {
    execSync(`git merge-base --is-ancestor ${target} HEAD`, { stdio: 'pipe' });
    return true;
  } catch {
    return false;
  }
}

// 6. Multi-Report Governance Validation (A002..A###, AUD-20, B.1, A007-4, A007-5, A008)
const reportsDir = resolve(ROOT, 'docs/execution-reports');
const reportFiles = readdirSync(reportsDir)
  .filter((f) => /^A\d{3}(?:-.*)?\.md$/.test(f) && f >= 'A002')
  .sort();
const statementTags = ['[implemented]', '[partial]', '[simulated]', '[not-started]'];
let reportsValidated = 0;

for (const reportFile of reportFiles) {
  const reportPath = resolve(reportsDir, reportFile);
  const content = readFileSync(reportPath, 'utf8');

  // Tag validation: relaxed rule requires at least one of the four statement tags
  const hasStatementTag = statementTags.some((tag) => content.includes(tag));
  if (!hasStatementTag) {
    fail(
      `[AUD-20/B.1] docs/execution-reports/${reportFile} must contain at least one statement tag ([implemented], [partial], [simulated], [not-started]).`
    );
  }

  // Header table validation
  const headerMap = {};
  for (const line of content.split('\n')) {
    const match = line.match(/^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|/);
    if (match && match[1] !== '---' && match[1] !== 'Field') {
      headerMap[match[1].trim()] = match[2].trim();
    }
    if (line.startsWith('---') && Object.keys(headerMap).length > 2) break;
  }

  const requiredHeaderKeys = ['Report ID', 'Date', 'Author', 'Evidence SHA', 'CI run'];
  if (reportFile >= 'A008.md') {
    requiredHeaderKeys.push('Task ID');
  }
  for (const key of requiredHeaderKeys) {
    if (!headerMap[key]) {
      fail(`[A007-4] docs/execution-reports/${reportFile} header table is missing mandatory field '${key}'.`);
    }
  }

  // Evidence SHA ancestor verification
  if (headerMap['Evidence SHA']) {
    const cleanSha = headerMap['Evidence SHA'].replace(/[`\[\]]/g, '').split(/[\s(/]/)[0];
    if (!isAncestor(cleanSha)) {
      fail(
        `[A007-4/AUD-COMMIT] docs/execution-reports/${reportFile} Evidence SHA '${cleanSha}' is not an ancestor of HEAD.`
      );
    }
  }
  reportsValidated++;
}

pass(
  `[AUD-20/B.1/A007-4/5] Validated ${reportsValidated} execution reports (${reportFiles[0]}..${reportFiles[reportFiles.length - 1]}) tags, headers, and Evidence SHA ancestors.`
);

// 7. Verify P0 probes cannot be silently skipped in apps/api/package.json (D.1)
const apiPkg = JSON.parse(readFileSync(resolve(ROOT, 'apps/api/package.json'), 'utf8'));
if (apiPkg.scripts?.test?.includes('--exclude') || apiPkg.scripts?.test?.includes('p0-probes')) {
  fail('[D.1] apps/api/package.json test script must run all tests without excluding p0-probes.conformance.test.ts.');
} else {
  pass('[D.1] Verified apps/api test script runs p0-probes.conformance.test.ts without exclusions.');
}

// 8. Verify mandatory alpha warning in README.md, admin UI renderer, and release template (OSR-11)
const ALPHA_WARNING = 'Alpha version with known defects. Do not use in production or input real sensitive data.';
for (const rel of ['README.md', 'apps/web/src/renderer.ts', '.github/release-template.md']) {
  const txt = readFileSync(resolve(ROOT, rel), 'utf8');
  if (!txt.includes(ALPHA_WARNING)) {
    fail(`[OSR-11] Missing mandatory alpha warning text in ${rel}`);
  }
}
pass('[OSR-11] Mandatory alpha warning verified in README.md, admin UI renderer, and release-notes template.');

// 9. Historical SHA mapping and commit ancestor verification (DR-AUD-001 / Rewrite Errata)
// Verify that historical SHAs cited in older reports (A002, A003) resolve to valid ancestors of HEAD
const citedHistoricalShas = ['196deb5', '76f2823', '6073d6c'];
let ancestorsOk = true;
for (const sha of citedHistoricalShas) {
  if (!isAncestor(sha)) {
    ancestorsOk = false;
    fail(`[AUD-COMMIT] Commit SHA '${sha}' cited in reports does not resolve to an ancestor of HEAD via SHA mapping.`);
  }
}
if (ancestorsOk) {
  pass('[AUD-COMMIT] Historical commit SHAs cited in older reports (196deb5, 76f2823, 6073d6c) resolve to valid ancestors of HEAD via SHA mapping.');
}

// 10. Documentation Identity & Registry Gate (IAHP PROC-1)
try {
  execSync('node scripts/docs-check', { cwd: ROOT, stdio: 'inherit' });
  pass('[IAHP-PROC-1] Documentation registry, class sequences, H1 matching, frozen checksums, and INDEX verified.');
} catch (err) {
  fail('[IAHP-PROC-1] Documentation identity check failed (scripts/docs-check).');
}

// 11. Autonomous Triage Gate (scripts/triage, HO-1b)
try {
  execSync('node scripts/triage', { cwd: ROOT, stdio: 'inherit' });
  pass('[HO-1b] Autonomous triage gate passed.');
} catch (err) {
  fail('[HO-1b] Autonomous triage check failed (scripts/triage).');
}

if (errors.length > 0) {
  console.error(`\nAudit check FAILED with ${errors.length} error(s).`);
  process.exit(1);
} else {
  console.log('\nAll DR-AUD-001 & OSR-001 audit governance checks PASSED.');
}
