#!/usr/bin/env node
/**
 * Living Portfolio Documentation Index Generator (`scripts/docs-index`)
 * Generates `docs/INDEX.md` directly from `docs/doc-registry.json`.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { resolve, relative } from 'node:path';

const ROOT = resolve(import.meta.dirname, '..');
const REGISTRY_PATH = resolve(ROOT, 'docs/doc-registry.json');
const INDEX_PATH = resolve(ROOT, 'docs/INDEX.md');

export function generateIndexContent(registry) {
  const sections = [
    { class: 'A', title: 'Execution Reports & Receipts (Class A)' },
    { class: 'H', title: 'Handover Snapshots (Class H)' },
    { class: 'P', title: 'Plans & Protocols (Class P)' },
    { class: 'G', title: 'Guides, References & Templates (Class G)' },
    { class: 'L', title: 'Grandfathered Legacy Documents (Class L)' },
  ];

  let out = '# Living Portfolio Documentation Index\n\n';
  out += '<!-- This file is auto-generated by scripts/docs-index from docs/doc-registry.json. Do not edit manually. -->\n\n';

  for (const sec of sections) {
    const docs = registry.filter((d) => d.class === sec.class);
    out += `## ${sec.title}\n\n`;
    if (docs.length === 0) {
      out += '*(No entries)*\n\n';
      continue;
    }

    out += '| ID | Title | Status | File | Supersedes |\n';
    out += '| :--- | :--- | :--- | :--- | :--- |\n';
    for (const doc of docs) {
      const relPath = doc.path.replace(/^docs\//, '');
      const supersedes = doc.supersedes ? `\`${doc.supersedes}\`` : '—';
      out += `| \`${doc.id}\` | ${doc.title} | \`${doc.status}\` | [${doc.path.split('/').pop()}](${relPath}) | ${supersedes} |\n`;
    }
    out += '\n';
  }

  return out;
}

export function buildIndex(registryPath = REGISTRY_PATH, indexPath = INDEX_PATH) {
  const registry = JSON.parse(readFileSync(registryPath, 'utf8'));
  const content = generateIndexContent(registry);
  writeFileSync(indexPath, content, 'utf8');
  return content;
}

if (process.argv[1] && process.argv[1].endsWith('docs-index')) {
  buildIndex();
  console.log('✓ docs/INDEX.md successfully generated from docs/doc-registry.json.');
}
