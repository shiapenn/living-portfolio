#!/usr/bin/env node
/**
 * WP-17.13 / WP-17.14 / WP-17.15 — Automated Design Audit (L0–L7).
 * Enforces static CSS/token/template invariants (L0–L6) and L7 hard-coded value audit.
 * Run with `--live` to also execute Playwright DOM audits.
 * Run with `--l7-json` to emit machine-readable L7 counts per category.
 */
import { readFileSync, readdirSync, statSync, existsSync, mkdtempSync, writeFileSync, rmSync } from 'node:fs';
import { resolve, relative, join } from 'node:path';
import { tmpdir } from 'node:os';
import { execSync } from 'node:child_process';

const ROOT = resolve(new URL('..', import.meta.url).pathname);

function walk(dir, exts, out = []) {
  if (!existsSync(dir)) return out;
  for (const name of readdirSync(dir)) {
    if (name === 'node_modules' || name === 'dist' || name === '.turbo') continue;
    const p = join(dir, name);
    const st = statSync(p);
    if (st.isDirectory()) walk(p, exts, out);
    else if (exts.some((e) => name.endsWith(e))) out.push(p);
  }
  return out;
}

const cssFiles = walk(resolve(ROOT, 'packages/ui-admin/src'), ['.css']);
const adminTsFiles = [
  ...walk(resolve(ROOT, 'apps/web/src/pages/admin'), ['.ts']),
  ...walk(resolve(ROOT, 'apps/web/src/settings/modules'), ['.ts']),
];

const results = {
  L0: { name: 'Text Purposes', measured: 0, violations: [] },
  L1: { name: 'Structure Tiers', measured: 0, violations: [] },
  L2: { name: 'Rhythm (Box Gaps)', measured: 0, violations: [] },
  L3: { name: 'Type Roles', measured: 0, violations: [] },
  L4: { name: 'Interaction', measured: 0, violations: [] },
  L5: { name: 'Tokens & Links', measured: 0, violations: [] },
  L6: { name: 'Components (Zero Margin)', measured: 0, violations: [] },
  L7: { name: 'Hard-Coded Value Audit', measured: 0, violations: [] },
};

// L0: Ban section description prop in FormSection calls across admin pages/settings
for (const f of adminTsFiles) {
  const rel = relative(ROOT, f);
  if (rel.includes('gallery') || rel.includes('canary') || rel.includes('fixture') || rel.endsWith('.test.ts')) continue;
  const src = readFileSync(f, 'utf8');
  const matches = src.match(/renderFormSection\s*\(\s*\{[\s\S]*?\}\s*\)/g) || [];
  results.L0.measured += matches.length;
  for (const m of matches) {
    const headerPart = m.split(/\bfieldsHtml\s*:/)[0] || m;
    if (/\bdescription\s*:/.test(headerPart)) {
      results.L0.violations.push(`${rel}: FormSection uses banned section description (move to consequence above ActionBar or delete)`);
    }
  }
}

// L1/L2/L3/L5/L6: Check admin CSS files
const tokensCss = readFileSync(resolve(ROOT, 'packages/design-tokens/src/tokens.css'), 'utf8');
results.L3.measured++;
if (!tokensCss.includes('--lp-font-size-13: 13px;')) {
  results.L3.violations.push('packages/design-tokens/src/tokens.css missing --lp-font-size-13: 13px');
}

for (const f of cssFiles) {
  const rel = relative(ROOT, f);
  if (rel.includes('canary') || rel.includes('legacy')) continue;
  const lines = readFileSync(f, 'utf8').split('\n');
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (line.startsWith('/*') || line.startsWith('*')) continue;
    if (/^margin(?:-(?:top|bottom|left|right|block|inline))?\s*:/.test(line)) {
      results.L6.measured++;
      const allowed =
        /^margin\s*:\s*0(?:\s+auto)?\s*;?$/.test(line) ||
        /^margin-(?:top|bottom|left|right|block|inline)\s*:\s*(?:0|auto)\s*;?$/.test(line);
      if (!allowed) {
        results.L6.violations.push(`${rel}:${i + 1}: non-zero component margin "${line}"`);
      }
    }
    if (rel.includes('components/') || rel.includes('templates/dfinal-system.css') || rel.includes('primitives/field/')) {
      if (line.includes('--lp-font-size-12')) {
        results.L3.measured++;
        results.L3.violations.push(`${rel}:${i + 1}: uses --lp-font-size-12 below 13px floor`);
      }
    }
  }
}

// L5: Check admin-shell.ts anti-FOUC + data-archetype
const shellSrc = readFileSync(resolve(ROOT, 'apps/web/src/layouts/admin-shell.ts'), 'utf8');
results.L5.measured++;
if (!shellSrc.includes('data-theme-switching') && !shellSrc.includes('prefers-color-scheme: dark')) {
  results.L5.violations.push('apps/web/src/layouts/admin-shell.ts missing head anti-FOUC dark first-paint script');
}
results.L1.measured++;
if (!shellSrc.includes('data-archetype=')) {
  results.L1.violations.push('apps/web/src/layouts/admin-shell.ts missing data-archetype emission');
}

// L4/D4: Manifest coverage check
const manifestSrc = readFileSync(resolve(ROOT, 'tests/e2e/wp17-manifest.ts'), 'utf8');
const manifestEntries = (manifestSrc.match(/\bid:\s*'/g) || []).length;
results.L4.measured += manifestEntries;
if (manifestEntries < 20) {
  results.L4.violations.push(`tests/e2e/wp17-manifest.ts has only ${manifestEntries} entries (expected >= 20)`);
}

// ============================================================================
// L7: Hard-Coded Value Audit (WP-17.15)
// Scans *.css, *.ts (admin UI/primitives/components/pages/settings), *.svg
// outside the token layer (packages/design-tokens).
// ============================================================================
const allowlistPath = resolve(ROOT, 'docs/design/hardcode-allowlist.json');
const allowlistData = existsSync(allowlistPath)
  ? JSON.parse(readFileSync(allowlistPath, 'utf8'))
  : { maxEntries: 10, entries: [] };
const allowEntries = allowlistData.entries || [];
if (allowEntries.length > 10) {
  results.L7.violations.push(`docs/design/hardcode-allowlist.json has ${allowEntries.length} entries (max allowed: 10)`);
}
const allowKeys = new Set(allowEntries.map((e) => `${e.file}|${e.category}|${e.pattern}`));

const l7Categories = {
  colour: [],
  length: [],
  'border-radius': [],
  'box-shadow': [],
  opacity: [],
  motion: [],
  'z-index': [],
  typography: [],
  'line-clamp': [],
  'outline-offset': [],
  breakpoint: [],
  'max-width': [],
  'inline-style': [],
};

function recordL7(category, file, line, snippet) {
  results.L7.measured++;
  const clean = snippet.trim().slice(0, 120);
  // Check allowlist
  for (const e of allowEntries) {
    if (e.file === file && e.category === category && clean.includes(e.pattern)) {
      return;
    }
  }
  l7Categories[category].push(`${file}:${line}: ${clean}`);
  results.L7.violations.push(`[${category}] ${file}:${line}: ${clean}`);
}

function scanL7CssFile(filePath, rel, onRecord) {
  const lines = readFileSync(filePath, 'utf8').split('\n');
  let inComment = false;
  for (let i = 0; i < lines.length; i++) {
    let line = lines[i];
    if (inComment) {
      if (line.includes('*/')) inComment = false;
      continue;
    }
    if (line.trim().startsWith('/*')) {
      if (!line.includes('*/')) inComment = true;
      continue;
    }
    // Strip inline comments
    line = line.replace(/\/\*.*?\*\//g, '').trim();
    if (!line || line.startsWith('//')) continue;

    // 1. Breakpoints (@media / @container with raw px/em/rem)
    if (/^@(?:media|container)\b/.test(line) && /\b\d+(?:\.\d+)?(?:px|rem|em)\b/.test(line)) {
      onRecord('breakpoint', rel, i + 1, line);
      continue;
    }

    // 2. Colour literals (hex, rgb/rgba, hsl/hsla, oklch)
    if (/#[0-9a-fA-F]{3,8}\b|\b(?:rgba?|hsla?|oklch)\s*\(/.test(line)) {
      onRecord('colour', rel, i + 1, line);
    }

    // 3. Border-radius literal (non-zero, non-var)
    if (/^border(?:-[a-z]+)?-radius\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== '0' && val !== '0px' && val !== 'inherit' && val !== 'none') {
        onRecord('border-radius', rel, i + 1, line);
      }
    }

    // 4. Box-shadow literal (non-none, non-var)
    if (/^box-shadow\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== 'none' && val !== 'inherit') {
        onRecord('box-shadow', rel, i + 1, line);
      }
    }

    // 5. Opacity literal (fractional opacity like 0.5, 0.85, etc.; 0 and 1 are visibility states)
    if (/^opacity\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== '0' && val !== '1' && val !== 'inherit') {
        onRecord('opacity', rel, i + 1, line);
      }
    }

    // 6. Motion durations & easings (ms/s or cubic-bezier/ease literals)
    if (/^(?:transition|animation)(?:-[a-z-]+)?\s*:/.test(line)) {
      if (/\b\d+(?:\.\d+)?m?s\b/.test(line) || /\b(?:cubic-bezier\(|ease-in-out|ease-in|ease-out|\bease\b)\b/.test(line)) {
        onRecord('motion', rel, i + 1, line);
      }
    }

    // 7. z-index literal number
    if (/^z-index\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== 'auto' && val !== 'inherit' && val !== '0') {
        onRecord('z-index', rel, i + 1, line);
      }
    }

    // 8. Typography literals (font-size, font-weight, line-height, letter-spacing without var())
    if (/^(?:font-size|font-weight|line-height|letter-spacing)\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (!['inherit', 'normal', '0', 'initial', 'unset'].includes(val)) {
        onRecord('typography', rel, i + 1, line);
      }
    }

    // 9. line-clamp literal count
    if (/^(?:-webkit-)?line-clamp\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== 'unset' && val !== 'none') {
        onRecord('line-clamp', rel, i + 1, line);
      }
    }

    // 10. outline-offset literal
    if (/^outline-offset\s*:/.test(line) && !line.includes('var(')) {
      const val = line.split(':')[1]?.replace(/;$/, '').trim() || '';
      if (val !== '0' && val !== '0px') {
        onRecord('outline-offset', rel, i + 1, line);
      }
    }

    // 11. max-width in ch/px literal
    if (/^max-width\s*:/.test(line) && !line.includes('var(') && /\b\d+(?:\.\d+)?(?:px|ch|rem|em)\b/.test(line)) {
      onRecord('max-width', rel, i + 1, line);
    }

    // 12. General px/rem/em lengths outside already-counted properties
    if (
      !/^(?:border(?:-[a-z]+)?-radius|box-shadow|font-size|line-height|letter-spacing|outline-offset|max-width|@)/.test(line) &&
      line.includes(':') &&
      !line.startsWith('--')
    ) {
      const rhs = line.slice(line.indexOf(':') + 1);
      const units = rhs.match(/\b(\d+(?:\.\d+)?)(px|rem|em)\b/g) || [];
      const bad = units.filter((u) => u !== '0px' && u !== '0rem' && u !== '0em');
      if (bad.length > 0) {
        onRecord('length', rel, i + 1, line);
      }
    }
  }
}

function scanL7TsFile(filePath, rel, onRecord) {
  const lines = readFileSync(filePath, 'utf8').split('\n');
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (line.startsWith('//') || line.startsWith('*')) continue;
    if (/\bstyle\s*=\s*["'`]/.test(line) && !rel.includes('appearance')) {
      onRecord('inline-style', rel, i + 1, line);
    }
    if (/\.style\.(?:color|background|backgroundColor|border|borderColor|borderRadius|padding|margin|fontSize|fontWeight|opacity|boxShadow|gap|width|height)\s*=/.test(line) && !rel.includes('appearance')) {
      onRecord('inline-style', rel, i + 1, line);
    }
  }
}

if (process.argv.includes('--self-test')) {
  const tmpDir = mkdtempSync(join(tmpdir(), 'lp-l7-selftest-'));
  try {
    const cssFixture = join(tmpDir, 'fixture.css');
    const tsFixture = join(tmpDir, 'fixture.ts');
    writeFileSync(
      cssFixture,
      [
        '@media (min-width: 768px) {',
        '  .probe {',
        '    color: #ff00aa;',
        '    padding: 12px;',
        '    border-radius: 6px;',
        '    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);',
        '    opacity: 0.65;',
        '    transition: color 150ms ease-in-out;',
        '    z-index: 42;',
        '    font-size: 15px;',
        '    -webkit-line-clamp: 2;',
        '    outline-offset: 3px;',
        '    max-width: 64ch;',
        '  }',
        '}',
      ].join('\n'),
      'utf8'
    );
    writeFileSync(
      tsFixture,
      'export const html = `<div style="padding: 8px">probe</div>`;\n',
      'utf8'
    );
    const detected = Object.fromEntries(Object.keys(l7Categories).map((k) => [k, 0]));
    const onHit = (cat) => { detected[cat] = (detected[cat] || 0) + 1; };
    scanL7CssFile(cssFixture, 'selftest/fixture.css', onHit);
    scanL7TsFile(tsFixture, 'selftest/fixture.ts', onHit);
    const missed = Object.entries(detected).filter(([, c]) => c === 0).map(([k]) => k);
    const passed = missed.length === 0;
    console.log(JSON.stringify({ passed, missed, detected }, null, 2));
    process.exit(passed ? 0 : 1);
  } finally {
    rmSync(tmpDir, { recursive: true, force: true });
  }
}

const l7CssFiles = walk(resolve(ROOT, 'packages/ui-admin/src'), ['.css']);
for (const f of l7CssFiles) {
  const rel = relative(ROOT, f);
  if (rel.includes('canary')) continue; // synthetic canary files test intentional breaks
  scanL7CssFile(f, rel, recordL7);
}

// Scan admin TS/SVG files for inline style= attributes and el.style.* mutations
const l7TsFiles = [
  ...walk(resolve(ROOT, 'apps/web/src/pages/admin'), ['.ts']),
  ...walk(resolve(ROOT, 'apps/web/src/settings/modules'), ['.ts']),
  ...walk(resolve(ROOT, 'apps/web/src/primitives'), ['.ts']),
  ...walk(resolve(ROOT, 'apps/web/src/components'), ['.ts']),
  ...walk(resolve(ROOT, 'apps/web/src/layouts'), ['.ts']),
];
for (const f of l7TsFiles) {
  const rel = relative(ROOT, f);
  if (rel.endsWith('.test.ts') || rel.includes('canary')) continue;
  scanL7TsFile(f, rel, recordL7);
}

if (process.argv.includes('--l7-json')) {
  const summary = {};
  for (const [cat, items] of Object.entries(l7Categories)) {
    summary[cat] = { count: items.length, sample: items.slice(0, 5) };
  }
  console.log(JSON.stringify({ totalL7Violations: results.L7.violations.length, allowlistCount: allowEntries.length, categories: summary }, null, 2));
  process.exit(results.L7.violations.length > 0 ? 1 : 0);
}

console.log('=== WP-17.15 Design Audit Summary (L0–L7, Manifest=' + manifestEntries + ' states) ===');
console.log('| Level | Name | Measured | Violations |');
console.log('| --- | --- | ---: | ---: |');
let totalViolations = 0;
for (const [k, v] of Object.entries(results)) {
  totalViolations += v.violations.length;
  console.log(`| ${k} | ${v.name} | ${v.measured} | ${v.violations.length} |`);
}

console.log('\n--- L7 Hard-Coded Value Breakdown ---');
for (const [cat, items] of Object.entries(l7Categories)) {
  console.log(`  ${cat}: ${items.length}`);
}

if (process.argv.includes('--live')) {
  execSync('pnpm exec playwright test tests/e2e/wp17-14-closed-world-audit.spec.ts tests/e2e/wp17-15-visual-system-audit.spec.ts --reporter=list', {
    cwd: ROOT,
    stdio: 'inherit',
  });
}

if (totalViolations > 0) {
  console.error('\n✗ Design Audit FAILED:');
  for (const [k, v] of Object.entries(results)) {
    for (const msg of v.violations.slice(0, 40)) console.error(`  - [${k}] ${msg}`);
    if (v.violations.length > 40) console.error(`  ... and ${v.violations.length - 40} more [${k}] violations`);
  }
  process.exit(1);
}
console.log('\n✓ pnpm design:audit PASSED (0 violations across L0–L7).');
