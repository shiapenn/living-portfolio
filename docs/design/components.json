      "parent": ["Page", "FormSection"],
      "children": ["Select"],
      "classFamilies": ["lp-tabs", "lp-tablist", "lp-tab", "lp-page-tabs-wrap"],
      "variantOf": null
    },
    {
      "name": "Tag",
      "variants": ["default", "removable", "confirmed", "suggested", "selected"],
      "gallerySampleId": "gallery-tag-sample",
      "parent": ["FormSection", "Subsection", "Item"],
      "children": ["Button"],
      "classFamilies": ["lp-tag", "lp-chip"],
      "variantOf": null
    }
  ],
