      "children": [],
      "classFamilies": ["lp-back-link"],
      "variantOf": null
    },
    {
      "name": "Button",
      "variants": ["primary", "secondary", "quiet", "text", "danger", "danger-confirm"],
      "gallerySampleId": "gallery-buttons-sample",
      "parent": ["ActionBar", "PageHeader", "SectionHeader", "Overlay", "Shell", "EditorToolbar"],
      "children": [],
      "classFamilies": ["lp-btn"],
      "variantOf": null
    },
    {
      "name": "Choice",
      "variants": ["button", "card", "single", "multiple", "segmented"],
      "gallerySampleId": "gallery-choice-sample",
