      "children": ["SectionHeader", "Subsection", "Field", "Choice", "Item", "ItemList", "Tag", "ActionBar", "StatusLabel"],
      "classFamilies": ["lp-form-section", "lp-section"],
      "variantOf": null
    },
    {
      "name": "Item",
      "variants": ["default", "has-actions", "selected", "trailing-status"],
      "gallerySampleId": "gallery-item-sample",
      "parent": ["ItemList", "FormSection", "Subsection"],
      "children": ["StatusLabel", "ActionBar"],
      "classFamilies": ["lp-item", "lp-list", "lp-item-list"],
      "variantOf": null
    },
    {
      "name": "Overlay",
      "variants": ["dialog", "sheet", "popover", "panel"],
      "gallerySampleId": "gallery-overlay-dialog-sample",
      "parent": ["Shell", "Page"],
      "children": ["ActionBar", "Field", "Button"],
      "classFamilies": ["lp-overlay", "lp-dialog", "lp-popover", "lp-modal", "lp-menu", "lp-tooltip"],
      "variantOf": null
    },
    {
      "name": "PageHeader",
      "variants": ["default"],
      "gallerySampleId": "gallery-page-header-sample",
      "parent": ["Page"],
      "children": ["BackLink", "Stepper", "Button"],
      "classFamilies": ["lp-page-header", "lp-page-title", "lp-page-description"],
      "variantOf": null
    },
    {
      "name": "SegmentedControl",
      "variants": ["mode-switch", "responsive-icons"],
      "gallerySampleId": "gallery-segmented-sample",
      "parent": ["EditorToolbar", "Gallery"],
      "children": [],
      "classFamilies": ["lp-segmented", "lp-segment"],
      "variantOf": "Choice"
    },
    {
      "name": "Select",
      "variants": ["default"],
      "gallerySampleId": "gallery-select-sample",
      "parent": ["Field", "Tabs"],
      "children": [],
      "classFamilies": ["lp-select"],
      "variantOf": "Field"
    },
    {
      "name": "StatusLabel",
      "variants": ["ok", "neutral", "warn", "danger", "muted"],
      "gallerySampleId": "gallery-status-label-sample",
      "parent": ["Item", "FormSection", "Page"],
      "children": [],
      "classFamilies": ["lp-status-indicator", "lp-status-dot", "lp-status-label", "lp-badge"],
      "variantOf": null
    },
    {
      "name": "Stepper",
      "variants": ["wizard"],
      "gallerySampleId": "gallery-stepper-sample",
      "parent": ["PageHeader", "WizardHeader"],
      "children": [],
      "classFamilies": ["lp-stepper", "lp-wizard-progress", "lp-wizard-step", "lp-auth-progress"],
      "variantOf": null
    },
    {
      "name": "Subsection",
      "variants": ["default"],
      "gallerySampleId": "gallery-subsection-sample",
      "parent": ["FormSection", "Page"],
      "children": ["Field", "Choice", "Item", "ItemList", "Tag", "ActionBar", "StatusLabel"],
      "classFamilies": ["lp-subsection"],
      "variantOf": null
    },
    {
      "name": "Tabs",
      "variants": ["tablist", "select-fallback"],
