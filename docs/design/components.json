      "children": [],
      "classFamilies": ["lp-choice", "lp-radio", "lp-checkbox"],
      "variantOf": null
    },
    {
      "name": "EdgePanel",
      "variants": ["left", "push"],
      "gallerySampleId": "gallery-overlay-panel-sample",
      "parent": ["Shell", "EditorShell"],
      "children": ["ActionBar", "Field", "ItemList"],
      "classFamilies": ["lp-drawer", "lp-editor-drawer", "lp-entries-drawer", "lp-overlay-push-panel"],
