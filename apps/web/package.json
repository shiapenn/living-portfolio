{
  "name": "@living-portfolio/web",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && pnpm build:client",
    "build:client": "esbuild src/client/admin-entry.ts --bundle --format=esm --target=es2022 --outfile=dist/client/admin-entry.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@living-portfolio/client": "workspace:*",
    "@living-portfolio/config": "workspace:*",
    "@living-portfolio/core": "workspace:*",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
