{
  "name": "@living-portfolio/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:p0-probes": "vitest run src/conformance/p0-probes.conformance.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@living-portfolio/ai": "workspace:*",
    "@living-portfolio/config": "workspace:*",
    "@living-portfolio/core": "workspace:*",
    "@living-portfolio/db": "workspace:*",
    "@living-portfolio/web": "workspace:*",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
