# The Living Portfolio — Environment Configuration (§13.12, §13.13)
PORT=3000
PRESET=free-cloud
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Outbound Tunnel (§13.8)
TUNNEL_TOKEN=
ADMIN_HOSTNAME=admin.example.com
API_HOSTNAME=api.example.com

# Model Provider Keys (Optional — falls back to local ONNX & extractive mode §10.8)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Notifications (§13.9)
NTFY_TOPIC=living-portfolio-alerts

# Encrypted Backups (§13.9)
AGE_PUBLIC_KEY=
S3_BACKUP_BUCKET=
