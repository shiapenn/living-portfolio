# The Living Portfolio — Environment Configuration (§13.12, §13.13, OSR-03)
# Generated from @living-portfolio/config schema. Do not edit manually; run `pnpm config:generate-env`.

# 1. Deployment & Infrastructure Configuration
# HTTP server listening port
PORT=4000
# Deployment environment class (development | staging | production)
DEPLOYMENT_CLASS=development
# Resource and provider preset (free-cloud | hobbyist-vps | local-only)
PRESET=free-cloud
# PostgreSQL + pgvector connection string (required in production) [REQUIRED IN PRODUCTION]
DATABASE_URL=postgresql://postgres:postgres@db:5432/portfolio
# Comma-separated allowed public web origins for CORS
SITE_ORIGIN=https://portfolio.example.com
# Allowed admin origin for CORS and cookie CSRF validation
ADMIN_ORIGIN=https://admin.example.com
# Admin interface hostname for edge routing (§13.4)
ADMIN_HOSTNAME=admin.example.com
# Public API hostname for edge routing (§13.4)
API_HOSTNAME=api.example.com
# Explicitly opt in to seeding synthetic demo records on startup (never true in production)
SEED_DEMO=false
# Notification topic for escalations and operational digests (§13.9)
NTFY_TOPIC=living-portfolio-alerts
# age recipient public key for encrypted database backups (§13.9)
AGE_PUBLIC_KEY=
# Path to confidential data exclusion list JSON file (§4.3, UX-03)
REDACTION_EXCLUSIONS_FILE=data/redaction-exclusions.json
# S3-compatible bucket name for encrypted backup archives (§13.9)
S3_BACKUP_BUCKET=

# 2. Public Site & Branding Configuration (PUBLIC_ prefix)
# Browser-safe base URL for API requests from the public web client
PUBLIC_API_BASE_URL=/api
# Public site title / brand label (OSR-09)
PUBLIC_SITE_NAME=Portfolio Sandbox
# Display name of the portfolio owner (OSR-04, OSR-09)
PUBLIC_OWNER_NAME=Portfolio Owner
# Short positioning statement shown on the home page (OSR-09)
PUBLIC_OWNER_STATEMENT=Systems engineer and design technologist.
# About page biography paragraph (OSR-09)
PUBLIC_OWNER_BIO=Systems engineer and design technologist.
# Optional URL or path to custom brand logo asset (OSR-09)
PUBLIC_SITE_LOGO_URL=
# Footer copyright or attribution line (OSR-09)
PUBLIC_SITE_FOOTER_TEXT=Powered by an open-source knowledge portfolio runtime (Apache-2.0).
# Mandatory notice when running an unofficial fork offering a service to others (OSR-09 §1.2)
PUBLIC_UNOFFICIAL_FORK_NOTICE=This is an unofficial fork and is not affiliated with the official project.

# 3. Secrets (Never commit values; supports *_FILE mounted secrets)
# HMAC signing key for session cookies, CSRF tokens, and redaction preview tokens (required in production) [REQUIRED IN PRODUCTION]
SESSION_SECRET=
# Bootstrap personal access token for headless/API admin operations
ADMIN_API_TOKEN=
# Outbound Cloudflare Tunnel token (§13.8)
TUNNEL_TOKEN=
# Optional Groq cloud provider API key (§13.5)
GROQ_API_KEY=
# Optional Google Gemini cloud provider API key (§13.5)
GEMINI_API_KEY=
# Optional OpenAI cloud provider API key (§13.5)
OPENAI_API_KEY=
